# ── Öffentliche Client-Konfiguration ───────────────────────────────────────
# Diese Datei (.env) wird NICHT mehr in App/Web-Builds ausgeliefert.
# Die öffentlichen Werte gehören in `assets/env`; nur sie werden gebündelt.
API_BASE_URL=https://domain.de/api/v2
PREVIEW_API_BASE_URL=https://preview.domain.de/api/v2
APP_ID=de.example.beyond

# ── Firebase (nur Android) ─────────────────────────────────────────────────
# Werte aus der Firebase Console bzw. android/app/google-services.json.
# Sie werden von deploy.py als --dart-define in den APK-Build gegeben.
FIREBASE_API_KEY=your-api-key
FIREBASE_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_PROJECT_ID=your-project-id

# ── Deployment (nur für deploy.py) ─────────────────────────────────────────
# Diese Werte bleiben ausschließlich lokal und dürfen niemals als Asset
# (auch nicht in assets/env) landen.
FTP_HOST=example.de
FTP_USER=username
FTP_PASS=password
FTP_PROJECT_ROOT_PATH=/www/htdocs
PREVIEW_FTP_PROJECT_ROOT_PATH=/preview/htdocs

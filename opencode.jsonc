{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Sinclear Beyond": {
      "type": "remote",
      "url": "https://sinclear.de/api/v2/mcp",
      "enabled": true,
    },
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true,
    },
  },
}
